---
import Button from "../../components/atoms/Button.astro";
import shirt from "../../../public/assets/shirt.png";
import hoodie from "../../../public/assets/hoodie.png";
import woman from "../../../public/assets/woman.png";
import FeaturedProductCard from "../molecules/FeaturedProductCard.astro";
---

<div
  class="container flex flex-wrap justify-center xl:justify-between gap-8 featured-products-section"
>
  <FeaturedProductCard
    image={shirt}
    imageAlt="men"
    title="MEN"
  >
    <a href="/"><Button>Shop</Button></a>
  </FeaturedProductCard>

  <FeaturedProductCard image={hoodie} 
  imageAlt="kids" title="KIDS">
    <a href="/"><Button>Shop</Button></a>
  </FeaturedProductCard>

  <FeaturedProductCard
    width="120px"
    image={woman}
    imageAlt="woman"
    title="WOMEN"
  >
    <a href="/"><Button>Shop</Button></a>
  </FeaturedProductCard>
</div>

<style>
  .featured-products-section {
    margin-top: 60px;
    margin-bottom: 80px;
  }
</style>
